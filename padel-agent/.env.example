# Clave de la API de Claude (https://console.anthropic.com)
ANTHROPIC_API_KEY=

# Ruta a la configuración del club y a la base de datos de reservas propias
CLUB_CONFIG=club.json
PADEL_DB=reservas.db

# --- Playtomic -------------------------------------------------------------
# 1) Disponibilidad pública (sin credenciales). Se usa el tenant_id de club.json.
#    Zona horaria en la que Playtomic devuelve las horas de los huecos.
PLAYTOMIC_SLOT_TZ=UTC

# 2) (Opcional) API de Playtomic para clubes/partners: da el detalle de cada
#    reserva (nombre, teléfono...). Las credenciales las facilita Playtomic.
PLAYTOMIC_PARTNER_API_BASE=
PLAYTOMIC_PARTNER_TOKEN=
PLAYTOMIC_PARTNER_BOOKINGS_PATH=/v1/bookings

# 3) (Opcional) Exportación CSV de reservas desde Playtomic Manager.
PLAYTOMIC_BOOKINGS_CSV=
